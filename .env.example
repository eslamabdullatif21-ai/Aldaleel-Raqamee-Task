DB_PASSWORD=choose-a-strong-database-password
JWT_SECRET=replace-with-at-least-32-random-bytes-before-deployment
CORS_ALLOWED_ORIGINS=http://localhost:3000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW=PT1M
JWT_USER_CACHE_TTL=PT1M
VIRTUAL_THREADS_ENABLED=true
DB_POOL_MAX_SIZE=16
DB_POOL_MIN_IDLE=16
DB_POOL_CONNECTION_TIMEOUT=5000
TOMCAT_MAX_CONNECTIONS=12000
TOMCAT_ACCEPT_COUNT=2000
TOMCAT_KEEP_ALIVE_TIMEOUT=20s
TOMCAT_MAX_THREADS=300
TOMCAT_MIN_SPARE_THREADS=30
JAVA_TOOL_OPTIONS=-Xms1g -Xmx2g
